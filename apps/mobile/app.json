{
  "expo": {
    "name": "Manhaj",
    "slug": "manhaj",
    "scheme": "manhaj",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manhaj.student",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#107265"
      },
      "package": "com.manhaj.student",
      "versionCode": 7,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF8F3",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-background-task",
      "expo-video",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Manhaj attaches a photo to your own case and note cards. It is never used for anything else."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c70d9ae5-6eae-4b84-a8ea-50a7826f1154"
      },
      "apiUrl": "https://manhaj-api-five.vercel.app"
    }
  }
}
